# Public site URL used for canonical links, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Optional. HTTPS endpoint that accepts a JSON POST from the contact form
# (e.g. a Formspree / Basin / internal API URL). When unset, the form runs in
# demonstration mode: it validates input but clearly states nothing was sent.
NEXT_PUBLIC_CONTACT_ENDPOINT=
